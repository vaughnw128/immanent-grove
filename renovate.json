{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/New_York)"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard",
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "ignorePaths": [
    "**/*.sops.*"
  ],
  "flux": {
    "managerFilePatterns": [
      "/applications/.+\\.ya?ml$/",
      "/cluster/.+\\.ya?ml$/",
      "/infrastructure/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/applications/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Flux distribution version in the FluxInstance",
      "managerFilePatterns": [
        "/^cluster/flux\\.ya?ml$/"
      ],
      "matchStrings": [
        "distribution:\\s*\\n\\s*version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Flux itself is the control plane: review its upgrades, do not automerge",
      "matchDepNames": [
        "fluxcd/flux2"
      ],
      "automerge": false
    }
  ]
}
