{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>vaughnw128/hakoniwa",
    "github>vaughnw128/hakoniwa:flux"
  ],
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "ignorePaths": [
    "**/*.sops.*"
  ],
  "flux": {
    "managerFilePatterns": [
      "/applications/.+\\.ya?ml$/",
      "/cluster/.+\\.ya?ml$/",
      "/infrastructure/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/applications/.+\\.ya?ml$/"
    ]
  }
}
